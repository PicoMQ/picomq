# Copy to .env and adjust. Used by compose.yml and compose.cluster.yml.

# HTTP protocol for every pico container: pico | ds.
# Kafka is on unless PICO_NO_KAFKA=true.
PICO_PROTOCOL=pico
# PICO_NO_KAFKA=true

# Auth is off by default in this harness. Uncomment to turn it on.
# The bootstrap token has a known dev default (see docs/operations/auth).
# PICO_AUTH=required
# PICO_AUTH_BOOTSTRAP_TOKEN=

# S3 client credentials for pico + aws-cli (compose.yml / compose.cluster.yml).
# Compose copies these into RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY on rustfs.
AWS_ACCESS_KEY_ID=picomq
AWS_SECRET_ACCESS_KEY=picomqpicomq
AWS_REGION=us-east-1
