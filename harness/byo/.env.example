# Copy to .env. Required for compose.yml / compose.cluster.yml.

# HTTP protocol: pico | ds. Kafka is on unless PICO_NO_KAFKA=true.
PICO_PROTOCOL=pico

# Root token seeded at startup, wire form BASE64URL(id).BASE64URL(32 bytes):
#   echo "$(printf 'ops/root' | basenc --base64url -w0 | tr -d '=').$(openssl rand 32 | basenc --base64url -w0 | tr -d '=')"
PICO_AUTH_BOOTSTRAP_TOKEN=

# Advertised URL for clients / redirects (single-node compose).
PICO_HTTP_ADDRESS=http://localhost:4437

# Cluster compose only — one advertised URL per node.
# PICO_HTTP_ADDRESS_1=http://localhost:4437
# PICO_HTTP_ADDRESS_2=http://localhost:4438

# External metadata log (RDS example).
PICO_META_URL=postgres://picomq:CHANGE_ME@mydb.xxxxx.us-east-1.rds.amazonaws.com:5432/picomq

# External object store. Real S3 needs a pre-created bucket; region matches AWS_REGION.
PICO_STORAGE=-2@s3://picomq?region=us-east-1

# S3 credentials. Prefer an instance/role profile in AWS and leave these empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
